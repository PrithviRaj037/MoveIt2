    </gazebo> -->


    <joint name="base_to_arm_joint" type="fixed">
        <parent link="tool_link"/>
        <child link="gripper_base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>    
</robot>    